# ==============================================================================
# Zyra User Encoder Service Configuration
# ==============================================================================

# Service Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Spring Boot Integration (Canonical Data Source)
SPRING_BOOT_BASE_URL=http://localhost:8081
SPRING_BOOT_TIMEOUT_SECONDS=10.0

# RabbitMQ Event Bus
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=zyra.user.events
RABBITMQ_QUEUE=zyra.user.profile.updated
RABBITMQ_ROUTING_KEY=user.profile.updated

# PostgreSQL Database (Canonical Zyra Storage)
POSTGRES_HOST=db.grduuzsxlugnmymgojky.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Saketh@20056
POSTGRES_DB=postgres
POSTGRES_MIN_POOL_SIZE=1
POSTGRES_MAX_POOL_SIZE=10
POSTGRES_TIMEOUT_SECONDS=10.0

# Qdrant Vector Store (User Embeddings)
QDRANT_URL=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=zyra_user_embeddings
QDRANT_VECTOR_DIMENSION=662
QDRANT_USE_IN_MEMORY=false

# Feature Flags / Future Stage Toggles
ENABLE_RABBITMQ_CONSUMER=false
