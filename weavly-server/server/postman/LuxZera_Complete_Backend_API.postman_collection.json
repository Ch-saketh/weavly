{
  "info": {
    "_postman_id": "8e4f9dd2-9468-4ce0-9a66-luxzera-complete",
    "name": "LuxZera Complete Backend API (Phase 8)",
    "description": "Comprehensive Postman collection for the entire LuxZera / Weavly Spring Boot platform, covering Authentication, User Profiles, 15-Area UserFitData Questionnaire, Profile Avatars, Recommendation Style Galleries, and Zyra User Encoder endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": "9e9e7b92-54db-4d77-9ee9-af5e3cccad79"
    },
    {
      "key": "imageId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "productId",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & Onboarding",
      "item": [
        {
          "name": "1.1 Register New Account",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex_chen\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Chen\",\n  \"email\": \"alex@weavly.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "1.2 Verify Registration OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@weavly.com\",\n  \"code\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify"
          }
        },
        {
          "name": "1.3 Login (Email & Password)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "    console.log('Saved token to collection variable: ' + jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@weavly.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "1.4 Google Sign-In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"GOOGLE_ID_OR_ACCESS_TOKEN_STRING\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/google"
          }
        },
        {
          "name": "1.5 Forgot Password Request",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@weavly.com\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          }
        },
        {
          "name": "1.6 Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@weavly.com\",\n  \"otpCode\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "02. User Profile & Aggregation",
      "item": [
        {
          "name": "2.1 Get Current User (Aggregated Profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.userId || jsonData.id) {",
                  "    pm.collectionVariables.set('userId', jsonData.userId || jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "2.2 Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profile/me"
          }
        },
        {
          "name": "2.3 Get Profile by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/profile/{{userId}}"
          }
        },
        {
          "name": "2.4 Update My Profile (with Avatar Upload)",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "phoneNumber", "value": "9876543210", "type": "text" },
                { "key": "gender", "value": "MALE", "type": "text" },
                { "key": "dateOfBirth", "value": "1996-06-12", "type": "text" },
                { "key": "bio", "value": "Minimalist streetwear and tailoring enthusiast", "type": "text" },
                { "key": "image", "type": "file", "src": [], "description": "Select optional image file for primary avatar" }
              ]
            },
            "url": "{{baseUrl}}/api/profile/me"
          }
        },
        {
          "name": "2.5 Update Profile by User ID",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "phoneNumber", "value": "9876543210", "type": "text" },
                { "key": "gender", "value": "MALE", "type": "text" },
                { "key": "dateOfBirth", "value": "1996-06-12", "type": "text" },
                { "key": "bio", "value": "Fashion forward", "type": "text" },
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/profile/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "03. User Fit Data Questionnaire (15 Areas)",
      "item": [
        {
          "name": "3.1 Get My Fit Data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user-fit-data/me"
          }
        },
        {
          "name": "3.2 Get Fit Data by User ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user-fit-data/{{userId}}"
          }
        },
        {
          "name": "3.3 Submit Complete 15-Area Questionnaire (My Profile)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"heightRange\": \"170–179 cm\",\n  \"exactHeightCm\": 175.5,\n  \"weightRange\": \"70–79 kg\",\n  \"exactWeightKg\": 73.0,\n  \"clothingSize\": \"L\",\n  \"fitPreferences\": [\"Regular\", \"Relaxed\"],\n  \"preferredStyles\": [\"Casual\", \"Minimal\", \"Streetwear\"],\n  \"avoidedStyles\": [\"Experimental / Avant-garde\"],\n  \"preferredClothingTypes\": [\"T-shirts\", \"Jeans\", \"Jackets / Outerwear\"],\n  \"avoidedClothingTypes\": [\"Suits / Blazers\"],\n  \"preferredColors\": [\"Black\", \"Navy\", \"Charcoal\"],\n  \"avoidedColors\": [\"Neon Yellow\", \"Hot Pink\"],\n  \"occasions\": [\"Everyday / Casual\", \"Work / Office\"],\n  \"primaryOccasion\": \"Everyday / Casual\",\n  \"budgetRange\": \"₹2,500–₹5,000\",\n  \"shoppingPriorities\": [\"Fit\", \"Comfort\", \"Quality\"],\n  \"fashionGoals\": [\"Build complete outfits\", \"Discover personal style\"]\n}"
            },
            "url": "{{baseUrl}}/api/user-fit-data/me"
          }
        },
        {
          "name": "3.4 Submit Complete 15-Area Questionnaire (by User ID)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"heightRange\": \"170–179 cm\",\n  \"exactHeightCm\": 175.5,\n  \"weightRange\": \"70–79 kg\",\n  \"exactWeightKg\": 73.0,\n  \"clothingSize\": \"L\",\n  \"fitPreferences\": [\"Regular\", \"Relaxed\"],\n  \"preferredStyles\": [\"Casual\", \"Minimal\", \"Streetwear\"],\n  \"avoidedStyles\": [\"Experimental / Avant-garde\"],\n  \"preferredClothingTypes\": [\"T-shirts\", \"Jeans\", \"Jackets / Outerwear\"],\n  \"avoidedClothingTypes\": [\"Suits / Blazers\"],\n  \"preferredColors\": [\"Black\", \"Navy\", \"Charcoal\"],\n  \"avoidedColors\": [\"Neon Yellow\", \"Hot Pink\"],\n  \"occasions\": [\"Everyday / Casual\", \"Work / Office\"],\n  \"primaryOccasion\": \"Everyday / Casual\",\n  \"budgetRange\": \"₹2,500–₹5,000\",\n  \"shoppingPriorities\": [\"Fit\", \"Comfort\", \"Quality\"],\n  \"fashionGoals\": [\"Build complete outfits\", \"Discover personal style\"]\n}"
            },
            "url": "{{baseUrl}}/api/user-fit-data/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "04. Style Inspiration & Recommendation Images",
      "item": [
        {
          "name": "4.1 Get My Recommendation Images",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recommendation-images/me"
          }
        },
        {
          "name": "4.2 Get Recommendation Images by User ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/recommendation-images/{{userId}}"
          }
        },
        {
          "name": "4.3 Upload Style Inspiration Image (My Profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('imageId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": [], "description": "Select style inspiration image (JPG, PNG, WebP)" }
              ]
            },
            "url": "{{baseUrl}}/api/recommendation-images/me"
          }
        },
        {
          "name": "4.4 Upload Style Inspiration Image (by User ID)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": [] }
              ]
            },
            "url": "{{baseUrl}}/api/recommendation-images/{{userId}}"
          }
        },
        {
          "name": "4.5 Delete Recommendation Image (by Image ID)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/recommendation-images/{{imageId}}"
          }
        },
        {
          "name": "4.6 Delete Recommendation Image (by User & Image ID)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/recommendation-images/{{userId}}/{{imageId}}"
          }
        }
      ]
    },
    {
      "name": "05. Internal Zyra AI & Encoder Context",
      "item": [
        {
          "name": "5.1 Get User Encoder Data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/internal/users/{{userId}}/encoder-data"
          }
        }
      ]
    },
    {
      "name": "06. Catalog & Products",
      "item": [
        {
          "name": "6.1 List Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "6.2 Get Product Details",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/products/{{productId}}"
          }
        },
        {
          "name": "6.3 AI Semantic Outfit Search",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/search/ai?q=minimalist+black+oversized+tee"
          }
        }
      ]
    }
  ]
}
